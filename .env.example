# ---- Public (safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---- Server-only (NEVER prefix with NEXT_PUBLIC_) ----
# Service role key — bypasses RLS. Required for admin writes.
SUPABASE_SERVICE_KEY=eyJ...

# Single shared password gate for /admin/*.
# Pick something long. Rotate by changing this value.
ADMIN_PASSWORD=replace-me-with-a-strong-password

# >= 32 chars random string. Used to HMAC-sign admin + visitor cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-me-with-openssl-rand-base64-48

# Optional. Test-only allowlist for the Microsoft Partner hub. Comma-separated.
# Each entry can be either an exact email or a whole domain (prefix with `@`).
# In production, leave UNSET so only @microsoft.com emails get partner access.
#
# Examples:
#   MICROSOFT_TEST_EMAILS=@echelix.app
#   MICROSOFT_TEST_EMAILS=ryan@echelix.app,partner@example.com
#   MICROSOFT_TEST_EMAILS=@echelix.app,bob@another.com
MICROSOFT_TEST_EMAILS=

# ---- Book-a-call (Outlook Bookings) ----
# Public Bookings page URL. When unset, the "Book a call" modal falls back to
# a mailto link instead of embedding the scheduler.
#   e.g. https://outlook.office365.com/owa/calendar/<your-booking>/bookings/
NEXT_PUBLIC_BOOKINGS_URL=

# ---- Pilot/PDF lead notifications (optional, server-only) ----
# Resend API key. If unset, use-case submissions still save to the DB and the
# admin inbox — the email notification is simply skipped (no-op).
RESEND_API_KEY=
# Verified sender for those emails, e.g. "Echelix Demo Hub <notifications@echelix.app>"
RESEND_FROM=
# Where use-case submission alerts are sent (defaults to sales@echelix.com).
SALES_NOTIFICATION_EMAIL=
